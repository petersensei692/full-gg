{
  "name": "full-gg",
  "version": "0.1.0",
  "description": "JournalApp - Professional Journal",
  "author": "PETER SENSEI",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-better-sqlite3.js",
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "dev:server": "cd src/server && nest start --watch",
    "build:server": "cd src/server && nest build",
    "start:server": "cd src/server && nest start",
    "start:server:debug": "cd src/server && nest start --debug --watch",
    "start:server:prod": "cd src/server && node dist/main",
    "lint:server": "cd src/server && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format:server": "cd src/server && prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test:server": "cd src/server && jest",
    "test:server:watch": "cd src/server && jest --watch",
    "test:server:cov": "cd src/server && jest --coverage",
    "test:server:debug": "cd src/server && node --inspect-brk -r tsconfig-paths/register -r ts-node/register ../../node_modules/.bin/jest --runInBand",
    "test:server:e2e": "cd src/server && jest --config ./test/jest-e2e.json",
    "typeorm:server": "cd src/server && ts-node --project tsconfig.json -r reflect-metadata -r tsconfig-paths/register ../../node_modules/typeorm/cli.js",
    "migration:run": "npm run typeorm:server -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm:server -- migration:revert -d src/database/data-source.ts",
    "seed:run": "cd src/server && ts-node -r tsconfig-paths/register src/database/seeds/run-seed.ts",
    "electron": "cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently -k -n \"next,server,electron\" -c \"cyan,magenta,green\" \"npm run dev:webpack\" \"npm run dev:server\" \"wait-on http://localhost:3000 http://localhost:5000 -t 90000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "node scripts/clean-electron-build.js && npm run build && npm run build:server && node scripts/patch-better-sqlite3.js && electron-builder && npx @electron/rebuild -f -w better-sqlite3 -m dist-electron/win-unpacked/resources/server",
    "electron:build:dir": "node scripts/clean-electron-build.js && npm run build && npm run build:server && node scripts/patch-better-sqlite3.js && electron-builder --dir && npx @electron/rebuild -f -w better-sqlite3 -m dist-electron/win-unpacked/resources/server",
    "electron:start": "cross-env NODE_ENV=production electron .",
    "electron-pack": "cross-env NEXT_PUBLIC_API_URL=http://127.0.0.1:5000 node scripts/clean-electron-build.js && npm run build && npm run build:server && node scripts/patch-better-sqlite3.js && electron-builder && npx @electron/rebuild -f -w better-sqlite3 -m dist-electron/win-unpacked/resources/server"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.journalapp.app",
    "productName": "JournalApp",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "out/**/*"
    ],
    "asarUnpack": [],
    "extraResources": [
      {
        "from": "out",
        "to": "out",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/server/dist",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "package.json",
        "to": "server/package.json",
        "filter": [
          "package.json"
        ]
      },
      {
        "from": "node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "shortcutName": "JournalApp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "better-sqlite3": "^11.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-is-dev": "^2.0.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "wait-on": "^8.0.1"
  }
}
